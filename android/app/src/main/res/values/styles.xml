<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Matches the app's canvas so there is no white flash before the WebView
         paints, and no mismatched colour behind the system bars. -->
    <style name="IdolTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/idol_canvas</item>
        <item name="android:statusBarColor">@color/idol_canvas</item>
        <item name="android:navigationBarColor">@color/idol_canvas</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
