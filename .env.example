# ---------------------------------------------------------------------------
# IDOL AI — configuration
# Copy to .env and edit, or pass these as environment variables.
# Every value is optional; the app runs with none of them.
# NEVER commit a real .env: it is git-ignored.
# ---------------------------------------------------------------------------

# HTTP port the API + UI are served on.
PORT=8787

# Interface to bind. 0.0.0.0 is correct for containers and most PaaS hosts.
HOST=0.0.0.0

# Where the knowledge index and encrypted GitHub token are stored.
IDOL_DATA_DIR=.data

# ---------------------------------------------------------------------------
# Knowledge sources
# ---------------------------------------------------------------------------
# Index a directory on this machine (offline use, or your own project's docs).
# Unset by default. Set to "." to index the checkout the server runs from.
# IDOL_LOCAL_DIR=.

# Repository indexed on boot, as "owner/repo". When unset, the value is derived
# from this checkout's git remote. Repositories can also be added from the UI.
# IDOL_DEFAULT_REPO=kartikkamboj380-star/IDOL-AI-

# Branch, tag, or commit SHA to index.
# IDOL_DEFAULT_REF=main

# ---------------------------------------------------------------------------
# GitHub access
# ---------------------------------------------------------------------------
# A token is only needed for PRIVATE repositories, or to raise the rate limit
# from 60 to 5,000 requests/hour. It is read on the server only and never sent
# to the browser. Fine-grained tokens need "Contents: read" permission.
# GITHUB_TOKEN=github_pat_xxx

# ---------------------------------------------------------------------------
# Optional inference provider (bring your own model — entirely optional)
# ---------------------------------------------------------------------------
# With no provider configured, IDOL AI runs in knowledge mode: extractive
# answers with exact citations, honestly labelled as such. Configuring a
# provider switches answers to grounded generation over the same passages.
#
# Supported: openai (also vLLM, LM Studio, Together, Groq, or Ollama's
# OpenAI-compatible endpoint), anthropic, azure-openai.
# IDOL_INFERENCE_PROVIDER=openai
# IDOL_INFERENCE_BASE_URL=https://api.openai.com/v1
# IDOL_INFERENCE_API_KEY=sk-xxx
# IDOL_INFERENCE_MODEL=gpt-4o-mini
# IDOL_INFERENCE_MAX_TOKENS=900
# IDOL_INFERENCE_TEMPERATURE=0.2
# IDOL_INFERENCE_TIMEOUT_MS=60000

# ---------------------------------------------------------------------------
# Limits and indexing scale
# ---------------------------------------------------------------------------
# IDOL_MAX_MESSAGE_CHARS=6000
# IDOL_MAX_HISTORY_TURNS=12
# IDOL_MAX_CONTEXT_CHARS=14000
# IDOL_MAX_FILES=400
# IDOL_MAX_FILE_BYTES=400000
# IDOL_MAX_SOURCE_BYTES=24000000
# IDOL_MAX_CHUNKS=12000
# IDOL_MAX_TREE_ENTRIES=6000

# Rate limiting (per client IP).
# IDOL_RATE_WINDOW_MS=60000
# IDOL_RATE_MAX=90

# ---------------------------------------------------------------------------
# Diagnostics
# ---------------------------------------------------------------------------
# IDOL_LOG_LEVEL=info
# Include IDOL AI's own source files in the knowledge base (off by default:
# indexing the app makes it answer questions about itself).
# IDOL_INDEX_APP_SOURCES=1

# Extra CA bundle for outbound HTTPS behind a corporate proxy.
# NODE_EXTRA_CA_CERTS=/usr/local/share/ca-certificates/corporate.crt
