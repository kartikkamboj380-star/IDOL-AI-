# Copy to .env for local Compose. These are development placeholders, not production secrets.
KAVRON_ENV=development
KAVRON_SESSION_SECRET=replace-this-development-secret-with-at-least-32-random-characters
KAVRON_ENCRYPTION_KEY=
KAVRON_WEB_PORT=8080
KAVRON_PUBLIC_ORIGIN=http://localhost:8080
KAVRON_ALLOWED_ORIGINS=http://localhost:8080
# Optional Vite development proxy target; browser API calls remain same-origin.
KAVRON_API_PROXY_TARGET=http://127.0.0.1:8000
KAVRON_COOKIE_SECURE=false
KAVRON_ALLOW_REGISTRATION=true
KAVRON_BOOTSTRAP_ADMIN_EMAIL=
KAVRON_REQUIRE_EMAIL_VERIFICATION=false
KAVRON_UPLOAD_LIMIT_MB=12
KAVRON_MAX_CHAT_HISTORY=24
KAVRON_PROVIDER_TIMEOUT_SECONDS=180
KAVRON_MAX_ACTIVE_JOBS_PER_USER=5

# Leave DATABASE_URL empty to use the persistent SQLite volume.
# To use the optional Compose PostgreSQL profile, configure a real strong password,
# start postgres first, then set: postgresql://kavron:YOUR_PASSWORD@postgres:5432/kavron
DATABASE_URL=
KAVRON_DB_POOL_MIN_SIZE=1
KAVRON_DB_POOL_MAX_SIZE=10
POSTGRES_DB=kavron
POSTGRES_USER=kavron
POSTGRES_PASSWORD=change-this-before-enabling-the-postgres-profile

# Server-side chat provider. User-managed provider credentials require a Fernet key.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_VISION_MODEL=
OPENAI_IMAGE_MODEL=
OPENAI_EMBEDDING_MODEL=
OLLAMA_BASE_URL=
OLLAMA_MODEL=
TAVILY_API_KEY=

# Account integrations (optional).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Existing Cloudflare GitHub connector. No GitHub token is used or sent to the browser.
KAVRON_GITHUB_WORKER_URL=https://bold-silence-a166.kartikkambojo800.workers.dev
KAVRON_GITHUB_KNOWLEDGE_REPO=kartikkamboj380-star/IDOL-AI-
KAVRON_GITHUB_KNOWLEDGE_REF=main

# Optional GitHub App workflows (separate from the public Worker knowledge connector).
# Keep private key material on the server.
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Optional S3-compatible storage. Leave S3_BUCKET empty to use local files.
S3_BUCKET=
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
