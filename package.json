{
  "name": "idol-ai",
  "version": "1.1.0",
  "private": true,
  "description": "IDOL AI \u2014 a retrieval-grounded assistant over GitHub repository knowledge, with an honest inference-adapter layer.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run typecheck && npm run build:web",
    "build:web": "vite build",
    "start": "node --enable-source-maps dist-server/server/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "build:server": "tsc -p tsconfig.build.json",
    "prestart": "",
    "test": "node --import tsx --test --test-reporter=spec tests/*.test.ts",
    "test:build": "npm run build && npm test",
    "index:self": "node --import tsx scripts/index-self.ts",
    "verify": "node --import tsx scripts/verify-journey.ts",
    "package": "node scripts/package.mjs",
    "build:device": "node scripts/build-device.mjs",
    "android:sync": "node scripts/android-sync.mjs",
    "android:apk": "npm run build:device && npm run android:sync"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "express": "^5.3.0",
    "highlight.js": "^11.12.0",
    "marked": "^15.0.12"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.20.5",
    "jsdom": "^26.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.6"
  }
}
